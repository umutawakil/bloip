{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Parameters": {
    "Environment": {
      "Type": "String"
    },
    "NotificationEmail": {
      "Type": "String",
      "Description": "Email to send Notifications/Alerts about application State."
    },
    "EmailBucket": {
      "Type": "String",
      "Description" : "Bucket to hold incoming emails"
    }
  },
  "Resources": {
    "UploadUser" : {
      "Description": "IAM user whose keys will be used to sign upload info",
      "Type" : "AWS::IAM::User",
      "Properties" : {}
    },
    "UserCredentials" :{
      "DependsOn": ["UploadUser"],
      "Type" : "AWS::IAM::AccessKey",
      "Properties" : {
        "UserName" : {"Ref" : "UploadUser"}
      }
    },
    "ErrorQueue" : {
      "Type" : "AWS::SQS::Queue",
      "Properties" : {
        "ReceiveMessageWaitTimeSeconds" : "20",
        "FifoQueue" : "true",
        "ContentBasedDeduplication" : "true"
      }
    },
    "ErrorQueuePolicy" : {
      "Type" : "AWS::SQS::QueuePolicy",
      "Properties" : {
        "Queues" :  [{"Ref": "ErrorQueue"}],
        "PolicyDocument": {
          "Statement":[{
            "Action":["SQS:SendMessage"],
            "Effect":"Allow",
            "Resource": {"Fn::GetAtt": ["ErrorQueue", "Arn"]},
            "Principal": {
              "AWS": {"Fn::GetAtt": ["UploadUser", "Arn"]}
            }
          }]
        }
      }
    },
    "EventQueue" : {
      "Type" : "AWS::SQS::Queue",
      "Properties" : {
        "ReceiveMessageWaitTimeSeconds" : "20",
        "FifoQueue" : "true",
        "ContentBasedDeduplication" : "true"
      }
    },
    "EventQueuePolicy" : {
      "Type" : "AWS::SQS::QueuePolicy",
      "Properties" : {
        "Queues" :  [{"Ref": "EventQueue"}],
        "PolicyDocument": {
          "Statement":[{
            "Action":["SQS:SendMessage"],
            "Effect":"Allow",
            "Resource": {"Fn::GetAtt": ["EventQueue", "Arn"]},
            "Principal": {
              "AWS": {"Fn::GetAtt": ["UploadUser", "Arn"]}
            }
          }]
        }
      }
    },
    "ErrorSNSTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "Subscription": [
          {
            "Endpoint": {
              "Ref": "NotificationEmail"
            },
            "Protocol": "email"
          }
        ],
        "DisplayName": {
          "Fn::Join": [
            "-",
            [
              {
                "Ref": "Environment"
              },
              "ERROR"
            ]
          ]
        }
      }
    },
    "ErrorPolicy": {
      "DependsOn" : ["ErrorSNSTopic","UploadUser"],
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "ErrorPolicy",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "sns:Publish"
              ],
              "Resource": {"Ref": "ErrorSNSTopic"}
            }
          ]
        },
        "Users": [
          {
            "Ref": "UploadUser"
          }
        ]
      }
    },
    "EventSNSTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "Subscription": [
          {
            "Endpoint": {
              "Ref": "NotificationEmail"
            },
            "Protocol": "email"
          }
        ],
        "DisplayName": {
          "Fn::Join": [
            "-",
            [
              {
                "Ref": "Environment"
              },
              "Event"
            ]
          ]
        }
      }
    },
    "EventPolicy": {
      "DependsOn" : ["EventSNSTopic","UploadUser"],
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "EventPolicy",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "sns:Publish"
              ],
              "Resource": {"Ref": "EventSNSTopic"}
            }
          ]
        },
        "Users": [
          {
            "Ref": "UploadUser"
          }
        ]
      }
    },
    "EmailSendPolicy": {
      "DependsOn" : ["UploadUser"],
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": {"Fn::Join": ["",["Email-send-policy-",{"Ref": "Environment"}]]},
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "ses:SendEmail",
                "ses:SendRawEmail"
              ],
              "Resource": "*"
            }
          ]
        },
        "Users": [
          {
            "Ref": "UploadUser"
          }
        ]
      }
    },
    "EmailReceiveBucketPolicy": {
      "DependsOn" : ["UploadUser"],
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "EmailBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid" : "statement1",
              "Effect": "Allow",
              "Action": ["s3:PutObject"],
              "Principal":{
                "Service":"ses.amazonaws.com"
              },
              "Resource": {"Fn::Join": ["",["arn:aws:s3:::",{"Ref": "EmailBucket"},"/*"]]}
            },
            {
              "Sid" : "statement2",
              "Effect": "Allow",
              "Action": [
                "s3:GetObject",
                "s3:DeleteObject"
              ],
              "Principal": {"AWS": {"Fn::Join": ["",["arn:aws:iam::298959928212:user/",{"Ref": "UploadUser"}]]}},
              "Resource": {"Fn::Join": ["",["arn:aws:s3:::",{"Ref": "EmailBucket"},"/*"]]}
            },
            {
              "Sid" : "statement3",
              "Effect": "Allow",
              "Action": [
                "s3:ListBucket"
              ],
              "Principal": {"AWS": {"Fn::Join": ["",["arn:aws:iam::298959928212:user/",{"Ref": "UploadUser"}]]}},
              "Resource": {"Fn::Join": ["",["arn:aws:s3:::",{"Ref": "EmailBucket"}]]}
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "UploadUsername" : {
      "Description" : "Username of the upload user",
      "Value" : {"Ref":  "UploadUser"}
    },
    "UploadUserArn" : {
      "Description" : "ARN for the upload user",
      "Value" :  {"Fn::GetAtt": ["UploadUser", "Arn"]}
    },
    "UserAccessKey" : {
      "Description" : "The public facing part of the upload users credential",
      "Value" : {"Ref":"UserCredentials"}
    },
    "UserSecretKey" : {
      "Description" : "The private/secret part of the upload users credential",
      "Value" :  {"Fn::GetAtt": ["UserCredentials", "SecretAccessKey"]}
    },
    "ErrorQueueURL": {
      "Description": "URL of the error queue",
      "Value": {"Ref": "ErrorQueue"}
    },
    "ErrorSNSTopic": {
      "Description": "ARN of the error topic",
      "Value": {"Ref": "ErrorSNSTopic"}
    },
    "EventQueueURL": {
      "Description": "URL of the event queue",
      "Value": {"Ref": "EventQueue"}
    },
    "EventSNSTopic": {
      "Description": "ARN of the event SNS topic",
      "Value": {"Ref": "EventSNSTopic"}
    }
  }
}