{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Infrastructure template for the audio recording CDN, its related resources such as an IAM user, and a static files CDN",
  "Parameters": {
    "ViewerTLSVersion": {
      "Type": "String",
      "Description": "TLS version to be used by cloudfront to communicate with the viewer."
    },
    "Environment": {
      "Type": "String",
      "Description": "Which QA stage this is running in such as dev, test, stage, production"
    },
    "HostedZoneId": {
      "Type": "String",
      "Description": "ZoneId for where the new record is to be created."
    },
    "CloudFrontZoneId": {
      "Type": "String",
      "Description": "ZoneId for cloudfront."
    },
    "CertificateARN": {
      "Type": "String",
      "Description": "ARN for the SSL cert to be used."
    },
    "MinimumAudioCacheTimeSecs": {
      "Type": "Number",
      "Description": "Minimum length of time for CDN to cache audio in seconds"
    },
    "MinimumAssetCacheTimeSecs": {
      "Type": "Number",
      "Description": "Minimum length of time for CDN to cache assetts in seconds"
    },
    "AllowedOrigins": {
      "Type": "CommaDelimitedList",
      "Description": "Minimum length of time for CDN to cache audio in seconds"
    }
  },
  "Resources": {
    "RecordingSourceBucket":{
      "Type": "AWS::S3::Bucket",
      "Description": "S3 Bucket for storing uploaded recordings",
      "Properties": {
        "BucketName": {"Fn::Join": ["",["bloip-recordings-",{"Ref" : "Environment"}]]},
        "CorsConfiguration" : {
          "CorsRules" : [
            {
              "AllowedHeaders": [
                "*"
              ],
              "AllowedMethods": [
                "PUT", "POST"
              ],
              "AllowedOrigins": {"Ref":  "AllowedOrigins"},
              "ExposedHeaders": [],
              "Id": "RuleId1",
              "MaxAge": 3600
            }
          ]
        }
      }
    },
    "UploadUser" : {
      "Description": "IAM user whose keys will be used to sign upload info",
      "Type" : "AWS::IAM::User",
      "Properties" : {}
    },
    "UserCredentials" :{
      "DependsOn": ["UploadUser"],
      "Type" : "AWS::IAM::AccessKey",
      "Properties" : {
        "UserName" : {"Ref" : "UploadUser"}
      }
    },
    "RecordingSourceBucketPolicy": {
      "Description": "Limit uploads to the upload user",
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "RecordingSourceBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "uploadUser-write-access",
              "Action": ["s3:PutObject", "s3:PutObjectAcl"],
              "Effect": "Allow",
              "Principal": {
                "AWS": {"Fn::GetAtt": ["UploadUser", "Arn"]}
              },
              "Resource": {"Fn::Join": ["",[{"Fn::GetAtt": ["RecordingSourceBucket", "Arn"]},"/*"]]}
            }
          ]
        }
      }
    },
    "MediaConvertPermission": {
      "DependsOn": ["UploadUser"],
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "MediaConvertPolicy",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "mediaconvert:DescribeEndpoints",
                "mediaconvert:CreateJob"
              ],
              "Resource": "*"
            },
            {
              "Effect": "Allow",
              "Action": [
                "iam:PassRole"
              ],
              "Resource": {"Fn::GetAtt": ["MediaConvertRole", "Arn"]}
            }
          ]
        },
        "Users": [
          {
            "Ref": "UploadUser"
          }
        ]
      }
    },
    "MediaConvertRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "mediaconvert.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "Path": "/",
        "Policies": [
          {
            "PolicyName": "mediaconvert-role-policies",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "read",
                  "Action": ["s3:Get*", "s3:List*"],
                  "Effect": "Allow",
                  "Resource": {"Fn::Join": ["",[{"Fn::GetAtt": ["RecordingSourceBucket", "Arn"]},"/*"]]}
                },
                {
                  "Sid": "write",
                  "Action": ["s3:Put*"],
                  "Effect": "Allow",
                  "Resource": {"Fn::Join": ["",[{"Fn::GetAtt": ["RecordingSourceBucket", "Arn"]},"/output/*"]]}
                }
              ]
            }
          }
        ]
      }
    },
    "RecordingsCloudFrontDistribution": {
       "DependsOn": ["RecordingsCFDCachePolicy"],
       "Type" : "AWS::CloudFront::Distribution",
       "Properties" : {
          "DistributionConfig" : {
             "Aliases" : [ {"Fn::Join": ["",[{"Ref" : "Environment"},"-recordings.bloip.com"]]}],
             "ViewerCertificate": {
                "AcmCertificateArn" : {"Ref" : "CertificateARN"},
                "SslSupportMethod": "sni-only",
                "MinimumProtocolVersion": {"Ref":"ViewerTLSVersion"}
              },
             "DefaultCacheBehavior" : {
                 "CachePolicyId" : {"Ref": "RecordingsCFDCachePolicy"},
                 "AllowedMethods": ["HEAD", "DELETE", "POST", "GET", "OPTIONS", "PUT", "PATCH"],
                 "TargetOriginId" : "RecordingSourceBucket",
                 "ViewerProtocolPolicy" : "allow-all"
             },
             "Enabled" : "true",
             "Origins" : [ {
                 "DomainName" : {"Fn::GetAtt": ["RecordingSourceBucket", "DomainName"]},
                 "Id" : "RecordingSourceBucket",
                 "S3OriginConfig" : {}
             }]
          }
       }
    },
    "RecordingsCFDCachePolicy": {
        "Type" : "AWS::CloudFront::CachePolicy",
        "Properties" : {
          "CachePolicyConfig" : {
            "MinTTL" : {"Ref": "MinimumAudioCacheTimeSecs"},
            "DefaultTTL" : {"Ref": "MinimumAudioCacheTimeSecs"},
            "MaxTTL" : {"Ref": "MinimumAudioCacheTimeSecs"},
            "ParametersInCacheKeyAndForwardedToOrigin" : {
                "CookiesConfig" : {"CookieBehavior" : "none"},
                "EnableAcceptEncodingBrotli" : "false",
                "EnableAcceptEncodingGzip" : "false",
                "HeadersConfig" : { "HeaderBehavior": "none"},
                "QueryStringsConfig" : {"QueryStringBehavior" :  "none"}
            },
            "Name" : "audio-cache-policy"
          }
      }
    },
    "RecordingsDNSRecord": {
      "Type": "AWS::Route53::RecordSetGroup",
      "DependsOn": ["RecordingsCloudFrontDistribution"],
      "Properties": {
        "HostedZoneId": {"Ref" : "HostedZoneId"},
        "RecordSets" : [
              {
                "Name" : {"Fn::Join": ["",[{"Ref":"Environment"},"-recordings.bloip.com."]]},
                "Type" : "A",
                "AliasTarget" : {
                    "HostedZoneId": {"Ref" : "CloudFrontZoneId"},
                    "DNSName" : {"Fn::GetAtt": ["RecordingsCloudFrontDistribution", "DomainName"]}
                }
              }
          ]
      }
    },
    "MSCBucket":{
      "Type": "AWS::S3::Bucket",
      "Description": "S3 Bucket for storing miscellaneous content such as js, images, etc etc",
      "Properties": {
        "AccessControl": "PublicRead",
        "BucketName": {"Fn::Join": ["",["bloip-msc-cdn-",{"Ref" : "Environment"}]]}
      }
    },
    "MSCCloudFrontDistribution": {
      "DependsOn": ["MSCCFDCachePolicy"],
       "Type" : "AWS::CloudFront::Distribution",
       "Properties" : {
          "DistributionConfig" : {
             "Aliases" : [ {"Fn::Join": ["",[{"Ref" : "Environment"},"-cdn.bloip.com"]]} ],
             "ViewerCertificate": {
                "AcmCertificateArn" : {"Ref" : "CertificateARN"},
                "SslSupportMethod": "sni-only",
                "MinimumProtocolVersion": {"Ref":"ViewerTLSVersion"}
              },
             "DefaultCacheBehavior" : {
                 "CachePolicyId" : {"Ref": "MSCCFDCachePolicy"},
                 "AllowedMethods" : [ "GET", "HEAD", "OPTIONS"],
                 "TargetOriginId" : "MSCBucket",
                 "ViewerProtocolPolicy" : "allow-all"
             },
             "Enabled" : "true",
             "Origins" : [ {
                 "DomainName" : {"Fn::GetAtt": ["MSCBucket", "DomainName"]},
                 "Id" : "MSCBucket",
                 "S3OriginConfig" : {}
             }]
          }
       }
    },
    "MSCCFDCachePolicy": {
      "Type" : "AWS::CloudFront::CachePolicy",
      "Properties" : {
        "CachePolicyConfig" : {
          "MinTTL" : {"Ref": "MinimumAssetCacheTimeSecs"},
          "DefaultTTL" : {"Ref": "MinimumAssetCacheTimeSecs"},
          "MaxTTL" : {"Ref": "MinimumAssetCacheTimeSecs"},
          "ParametersInCacheKeyAndForwardedToOrigin" : {
            "CookiesConfig" : {"CookieBehavior" : "none"},
            "EnableAcceptEncodingBrotli" : "false",
            "EnableAcceptEncodingGzip" : "false",
            "HeadersConfig" : { "HeaderBehavior": "none"},
            "QueryStringsConfig" : {"QueryStringBehavior" :  "all"}
          },
          "Name" : "asset-cache-policy"
        }
      }
    },
    "MSCDNSRecord": {
      "Type": "AWS::Route53::RecordSetGroup",
      "DependsOn": ["MSCCloudFrontDistribution"],
      "Properties": {
        "HostedZoneId": {"Ref": "HostedZoneId"},
        "RecordSets" : [
              {
                "Name" :{"Fn::Join": ["",[{"Ref" : "Environment"},"-cdn.bloip.com."]]},
                "Type" : "A",
                "AliasTarget" : {
                    "HostedZoneId": {"Ref" : "CloudFrontZoneId"},
                    "DNSName" : {"Fn::GetAtt": ["MSCCloudFrontDistribution", "DomainName"]}
                }
              }
          ]
      }
    }
  },
  "Outputs" : {
    "UploadUserArn" : {
      "Description" : "ARN for the upload user",
      "Value" :  {"Fn::GetAtt": ["UploadUser", "Arn"]}
    },
    "UserAccessKey" : {
      "Description" : "The public facing part of the upload users credential",
      "Value" : {"Ref":"UserCredentials"}
    },
    "UserSecretKey" : {
      "Description" : "The private/secret part of the upload users credential",
      "Value" :  {"Fn::GetAtt": ["UserCredentials", "SecretAccessKey"]}
    },
    "RecordingSourceURL" : {
      "Description" : "URL for recordings CDN",
      "Value" : {"Fn::Join": ["",["https://",{"Ref":"Environment"},"-recordings.bloip.com"]]}
    },
    "RecordingUploadURL" : {
      "Description" : "S3 file upload url",
      "Value" : {"Fn::Join": ["",["https://",{"Ref": "RecordingsUploadDNSRecord"}]]}
    },
    "RecordingSourceBucket" : {
      "Description" : "s3 bucket for recordings",
      "Value" :{"Ref": "RecordingSourceBucket"}
    },
    "PublicCDNURL" : {
      "Description" : "MSC CDN URL",
      "Value" :{"Fn::Join": ["",["https://",{"Ref" : "Environment"},"-cdn.bloip.com"]]}
    },
    "PublicCDNBucket" : {
      "Description" : "s3 bucket MSC CDN",
      "Value" : {"Ref": "MSCBucket"}
    },
    "MediaConvertRoleArn" : {
      "Description" : "Role to be used for media converter",
      "Value" :  {"Fn::GetAtt": ["MediaConvertRole", "Arn"]}
    }
  }
}
