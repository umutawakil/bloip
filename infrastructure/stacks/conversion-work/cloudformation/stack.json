{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Infrastructure template for queues and event triggered lambda for storing conversion work to be done and finished",
  "Parameters": {
    "Environment": {
      "Type": "String",
      "Description": "Which QA stage this is running in such as dev, test, stage, production"
    },
    "UploadUserArn": {
      "Type": "String",
      "Description": "The Amazon Resource Number for the upload user reading and writing to the queues."
    }
  },
  "Resources": {
    "NeedsConversionQueue" : {
      "Type" : "AWS::SQS::Queue",
      "Properties" : {
        "ReceiveMessageWaitTimeSeconds" : "20"
      }
    },
    "NeedsConversionQueuePolicy" : {
      "Type" : "AWS::SQS::QueuePolicy",
      "Properties" : {
        "Queues" :  [{"Ref": "NeedsConversionQueue"}],
        "PolicyDocument": {
          "Statement":[{
            "Action":["SQS:SendMessage","SQS:ReceiveMessage","SQS:DeleteMessage"],
            "Effect":"Allow",
            "Resource": {"Fn::GetAtt": ["NeedsConversionQueue", "Arn"]},
            "Principal": {
              "AWS": [{"Ref": "UploadUserArn"}]
            }
          }]
        }
      }
    },
    "ConversionCompleteQueue" : {
      "Type" : "AWS::SQS::Queue",
      "Properties" : {
        "ReceiveMessageWaitTimeSeconds" : "20"
      }
    },
    "ConversionCompleteQueuePolicy" : {
      "Type" : "AWS::SQS::QueuePolicy",
      "Properties" : {
        "Queues" :  [{"Ref": "ConversionCompleteQueue"}],
        "PolicyDocument": {
          "Statement":
          [
            {
              "Action":["SQS:ReceiveMessage","SQS:DeleteMessage"],
              "Effect":"Allow",
              "Resource": {"Fn::GetAtt": ["ConversionCompleteQueue", "Arn"]},
              "Principal": {
                "AWS": [{"Ref": "UploadUserArn"}]
              }
            }
          ]
        }
      }
    },
    "LambdaRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "Path": "/",
        "Policies": [
          {
            "PolicyName": "conversion-complete-lambda-policy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "SQS:SendMessage",
                  "Resource": {"Fn::GetAtt": ["ConversionCompleteQueue", "Arn"]}
                }
              ]
            }
          }
        ]
      }
    },
    "ConversionCompleteLambda": {
      "DependsOn": ["ConversionCompleteQueue","ConversionCompleteQueuePolicy"],
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Code": {"ZipFile" : "const AWS = require('aws-sdk');\nvar sqs = new AWS.SQS();\n\nexports.handler = function(event) {\n    console.log(\"REQUEST RECEIVED:\" + JSON.stringify(event));\n    var params = {\n        MessageBody: event.detail.jobId,\n        QueueUrl: process.env.QUEUE_URL,\n    };\n    sqs.sendMessage(params, function(err, data) {\n        if (err) console.log(err, err.stack);\n        else     console.log(data);\n    });\n};" },
        "Role": {
          "Fn::GetAtt": [
            "LambdaRole",
            "Arn"
          ]
        },
        "Description": "Triggered by Cloudwatch Events,processes completed MediaConvert jobs.",
        "Environment": {
          "Variables": {
            "QUEUE_URL": {"Ref": "ConversionCompleteQueue"}
          }
        },
        "Handler": "index.handler",
        "Runtime": "nodejs12.x",
        "Timeout": 30
      },
      "Metadata": {
        "cfn_nag": {
          "rules_to_suppress": [
            {
              "id": "W58",
              "reason": "Invalid warning: function has access to cloudwatch"
            },
            {
              "id": "W89",
              "reason": "Invalid warning: lambda not needed in VPC"
            },
            {
              "id": "W92",
              "reason": "Invalid warning: lambda does not need ReservedConcurrentExecutions"
            }
          ]
        }
      }
    },
    "ConversionCompleteLambdaEventInvokeConfig": {
      "Type": "AWS::Lambda::EventInvokeConfig",
      "Properties": {
        "FunctionName": {
          "Ref": "ConversionCompleteLambda"
        },
        "Qualifier": "$LATEST",
        "MaximumRetryAttempts": 0
      }
    },
    "MediaConvertEventRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "EventPattern": {
          "source": [
            "aws.mediaconvert"
          ],
          "detail": {
            "status": [
              "COMPLETE"
            ]
          }
        },
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Fn::GetAtt": [
                "ConversionCompleteLambda",
                "Arn"
              ]
            },
            "Id": "Target0"
          }
        ]
      }
    },
    "ConversionCompleteLambdaEventsInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Fn::GetAtt": [
            "ConversionCompleteLambda",
            "Arn"
          ]
        },
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "MediaConvertEventRule",
            "Arn"
          ]
        }
      }
    }
  },
  "Outputs" : {
    "NeedsConversionQueueName" : {
      "Description" : "Name for the needs-conversion queue",
      "Value" :  {"Fn::GetAtt": ["NeedsConversionQueue", "QueueName"]}
    },
    "NeedsConversionQueueUrl" : {
      "Description" : "URL for the needs-conversion queue",
      "Value" :  {"Ref" : "NeedsConversionQueue"}
    },
    "ConversionCompleteQueueName" : {
      "Description" : "Name for the conversion complete queue",
      "Value" :  {"Fn::GetAtt": ["ConversionCompleteQueue", "QueueName"]}
    },
    "ConversionCompleteQueueUrl" : {
      "Description" : "URL for the conversion complete queue URL",
      "Value" :  {"Ref" : "ConversionCompleteQueue"}
    }
  }
}
